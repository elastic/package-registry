{
  "name": "fips_compatible",
  "title": "FIPS Compatible",
  "version": "0.0.1",
  "release": "beta",
  "source": {
    "license": "Elastic-2.0"
  },
  "description": "Package containing policy templates with different fips_compatible values",
  "type": "integration",
  "download": "/epr/fips_compatible/fips_compatible-0.0.1.zip",
  "path": "/package/fips_compatible/0.0.1",
  "icons": [
    {
      "src": "/img/sample-logo.svg",
      "path": "/package/fips_compatible/0.0.1/img/sample-logo.svg",
      "title": "Sample logo",
      "size": "32x32",
      "type": "image/svg+xml"
    }
  ],
  "conditions": {
    "kibana": {
      "version": "^8.15.2"
    },
    "elastic": {
      "subscription": "basic"
    }
  },
  "owner": {
    "type": "elastic",
    "github": "elastic/integrations"
  },
  "categories": [
    "custom"
  ],
  "format_version": "3.4.0",
  "readme": "/package/fips_compatible/0.0.1/docs/README.md",
  "license": "basic",
  "screenshots": [
    {
      "src": "/img/sample-screenshot.png",
      "path": "/package/fips_compatible/0.0.1/img/sample-screenshot.png",
      "title": "Sample screenshot",
      "size": "600x600",
      "type": "image/png"
    }
  ],
  "assets": [
    "/package/fips_compatible/0.0.1/LICENSE.txt",
    "/package/fips_compatible/0.0.1/changelog.yml",
    "/package/fips_compatible/0.0.1/manifest.yml",
    "/package/fips_compatible/0.0.1/docs/README.md",
    "/package/fips_compatible/0.0.1/img/sample-logo.svg",
    "/package/fips_compatible/0.0.1/img/sample-screenshot.png"
  ],
  "policy_templates": [
    {
      "name": "not_fips",
      "title": "Not FIPS compatible",
      "description": "Policy template that is not FIPS compatible",
      "inputs": [
        {
          "type": "logfile",
          "title": "Collect sample logs from instances",
          "description": "Collecting sample logs"
        }
      ],
      "multiple": true,
      "fips_compatible": false
    },
    {
      "name": "fips",
      "title": "FIPS compatible",
      "description": "Policy template that is explicitly FIPS compatible",
      "inputs": [
        {
          "type": "logfile",
          "title": "Collect sample logs from instances",
          "description": "Collecting sample logs"
        }
      ],
      "multiple": true,
      "fips_compatible": true
    },
    {
      "name": "default_fips",
      "title": "Default FIPS compatibility",
      "description": "Policy template without fips_compatible field (defaults to compatible)",
      "inputs": [
        {
          "type": "logfile",
          "title": "Collect sample logs from instances",
          "description": "Collecting sample logs"
        }
      ],
      "multiple": true
    }
  ]
}
